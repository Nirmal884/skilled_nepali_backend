// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String           @id @default(uuid())
  userId            Int              @default(autoincrement())
  email             String           @unique
  fullName          String
  title             String?
  profilePicture    String?
  bio               String?
  password          String
  country           Int
  role              Role             @default(JOBSEEKER)
  phone             String?          @default("")
  jobCategories     JobCategory[]    @relation("UserJobCategories")
  applicantTypeId   String?
  applicantType     ApplicantType?   @relation(fields: [applicantTypeId], references: [id])
  experience        Float?
  pastExperience    String?
  resume            String?
  companyName       String?
  designation       String?
  companyLogo       String?
  centreName        String?
  centreLogo        String?
  jobs              Jobs[]
  skills            Skill[]          @relation("UserSkills")
  isProfileComplete Boolean          @default(false)
  workExperiences   WorkExperience[]
  educations        Education[]
  certifications    Certifications[]
  isAdminApproved   Boolean          @default(false)
  jobApplications   JobApplication[]
  otp               String?
  otpExpiry         DateTime?
  subscriptions     Subscriptions[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@map("user_profiles")
}

model WorkExperience {
  id          String    @id @default(uuid())
  userId      String
  title       String
  companyName String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@map("work_experiences")
}

model Education {
  id           String    @id @default(uuid())
  userId       String
  fieldOfStudy String?
  institution  String?
  startDate    DateTime?
  endDate      DateTime?
  isCompleted  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id])

  @@map("educations")
}

model Certifications {
  id                String    @id @default(uuid())
  userId            String
  certificationName String?
  issuingAuthority  String?
  issueDate         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id])

  @@map("certifications")
}

model JobCategory {
  id           String    @id @default(uuid())
  categoryName String    @unique
  users        User[]    @relation("UserJobCategories")
  jobs         Jobs[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("job_categories")
}

model ApplicantType {
  id                String    @id @default(uuid())
  applicantTypeName String    @unique
  users             User[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@map("applicant_types")
}

model Jobs {
  id                      String              @id @default(uuid())
  title                   String
  type                    JobType
  country                 Int
  location                String
  jobCategoryId           String
  jobCategory             JobCategory         @relation(fields: [jobCategoryId], references: [id])
  minSalary               Float               @default(0)
  maxSalary               Float
  currency                String              @default("QAR")
  experience              String?
  description             String?
  requirements            String[]            @default([])
  benefits                String[]            @default([])
  responsibilities        String[]            @default([])
  deadLine                DateTime?
  jobStatus               JobStatus           @default(PENDING)
  isUrgent                Boolean             @default(false)
  noOfOpenings            Int                 @default(1)
  userId                  String
  user                    User                @relation(fields: [userId], references: [id])
  isAdminApprovedDeletion Boolean             @default(false)
  adminApprovalStatus     AdminApprovalStatus @default(PENDING)
  deletionReason          String?             @default("")
  deleteRequestedOn       DateTime?           @default(now())
  adminApprovedOn         DateTime?
  jobApplications         JobApplication[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  deletedAt               DateTime?

  @@map("jobs")
}

model Skill {
  id        String    @id @default(uuid())
  skillName String    @unique
  users     User[]    @relation("UserSkills")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("skills")
}

model Testimonial {
  id        String              @id @default(uuid())
  name      String
  role      Role
  country   String?
  quote     String
  position  String?
  rating    Int
  company   String?
  status    AdminApprovalStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  @@map("testimonials")
}

model Enquiry {
  id        String         @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   MessageSubject
  enquiry   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@map("enquiries")
}

model JobApplication {
  id        String            @id @default(uuid())
  userId    String
  jobId     String
  status    ApplicationStatus @default(APPLIED)
  resume    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id])
  job  Jobs @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@map("job_applications")
}

model NewsLetter {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_letters")
}

model Subscriptions {
  id                String     @id @default(uuid())
  userId            String     @unique
  razorpaySubId     String     @unique
  planId            String
  planType          PlanType
  status            PlanStatus
  cancelAtPeriodEnd Boolean    @default(false)
  currentCycleStart DateTime?
  currentCycleEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum Role {
  JOBSEEKER
  EMPLOYER
  TRAINING_CENTRE
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  PENDING
  ACTIVE
  EXPIRED
  DELETED
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageSubject {
  JOBINQUIRY
  EMPLOYERPARTNERSHIP
  TRAININGINQUIRY
  GENERALINQUIRY
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

enum PlanStatus {
  CREATED // Created in DB/Razorpay, but payment not completed yet
  AUTHENTICATED // First payment authorized
  ACTIVE // Subscription is active and paid
  PAST_DUE // Auto-debit renewal failed (payment issue)
  CANCELLED // Subscription cancelled by user or admin
  COMPLETED // Max billing cycles reached
}

enum PlanType {
  MONTHLY_ELITE
  MONTHLY_PLATINUM
  YEARLY_ELITE
  YEARLY_PLATINUM
}
